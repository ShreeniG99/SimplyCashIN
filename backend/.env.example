ANTHROPIC_API_KEY=sk-ant-...
USE_STUB_LLM=0
DATABASE_URL=postgresql+asyncpg://scin:scin@localhost:5432/scin
TEST_DATABASE_URL=postgresql+asyncpg://scin:scin@localhost:5432/scin_test
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
REDIS_URL=redis://localhost:6379/0
# Run the in-process APScheduler daily overdue trigger (leave 0 on serverless)
ENABLE_SCHEDULER=0
# Hand the queue to the Celery worker after each trigger run (needs a worker)
ENABLE_CELERY_DISPATCH=0

# M3 channels — leave empty to use SimulatedChannel (no external sends)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
TWILIO_VALIDATE_SIGNATURE=0
TWILIO_TO_MAP=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO_MAP=

# M4 auth — leave empty for the dev fallback (owner "ramesh", no JWT needed)
SUPABASE_JWT_SECRET=
